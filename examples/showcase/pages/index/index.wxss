.hero {
  background: linear-gradient(135deg, #07c160 0%, #059669 100%);
  color: #ffffff;
  padding: 40rpx 32rpx 36rpx;
}
.hero-badge {
  display: inline-block;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}
.hero-title {
  font-size: 46rpx;
  font-weight: 800;
  margin-top: 14rpx;
}
.hero-desc {
  font-size: 26rpx;
  opacity: 0.92;
  margin-top: 10rpx;
  line-height: 1.5;
}
.hero-stats {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.stat {
  flex: 1;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 14rpx;
  padding: 16rpx 12rpx;
  text-align: center;
}
.stat-num {
  font-size: 32rpx;
  font-weight: 700;
}
.stat-label {
  font-size: 22rpx;
  opacity: 0.88;
  margin-top: 4rpx;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.card-head .card-title {
  margin-bottom: 0;
}
.pill {
  font-size: 22rpx;
  font-weight: 700;
  color: #059669;
  background: #d1fae5;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.ext-border {
  border: 2rpx solid #a7f3d0;
}
.input-row {
  margin-top: 20rpx;
}
.demo-input {
  margin-top: 10rpx;
  height: 72rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #f9fafb;
  font-size: 28rpx;
  box-sizing: border-box;
}
.card-dark {
  background: #1f2937;
  color: #f9fafb;
}
.card-dark .card-title {
  color: #ffffff;
}
.card-dark .muted {
  color: #9ca3af;
}
.row-inline {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.meter-row {
  margin-top: 12rpx;
}
.slider-wrap {
  margin-top: 10rpx;
}
.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}
.feat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.feat-item:last-child {
  border-bottom: 0;
}
.feat-name {
  font-size: 26rpx;
  color: #1f2937;
}
.feat-tag {
  font-size: 20rpx;
  color: #2563eb;
  background: #dbeafe;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.footer-cta {
  padding: 8rpx 24rpx 48rpx;
}
