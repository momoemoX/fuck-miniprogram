.bar-track {
  margin-top: 16rpx;
  background: #e5e7eb;
  border-radius: 999rpx;
  height: 24rpx;
  overflow: hidden;
}
.scroll-bar {
  width: 60px;
  height: 24rpx;
  background: #3b82f6;
  border-radius: 999rpx;
}
.demo-scroll {
  margin-top: 16rpx;
  height: 180rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #f9fafb;
}
.scroll-filler {
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  font-size: 24rpx;
  color: #4b5563;
}
.scroll-filler.mid {
  background: #eff6ff;
}
.scroll-filler.end {
  background: #ecfdf5;
  color: #059669;
}
.lab-canvas {
  width: 280px;
  height: 110px;
  border-radius: 12rpx;
  overflow: hidden;
}
.back-wrap {
  padding: 8rpx 24rpx 48rpx;
}
