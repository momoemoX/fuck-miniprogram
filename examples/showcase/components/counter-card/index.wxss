.counter-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}
.counter-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}
.counter-sub {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}
.counter-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.step-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: #e5e7eb;
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
}
.step-btn.primary {
  background: #07c160;
  color: #ffffff;
}
.step-val {
  min-width: 48rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #07c160;
}
